# Dashboard password - change this to a strong password
DASHBOARD_PASSWORD=your-password-here

# Session secret - use a long random string
SESSION_SECRET=replace-with-a-long-random-secret-string

# Resend API key - get from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# The "from" email address (must be verified in Resend)
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Your app's public URL (used for unsubscribe links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
